---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import commingSoonImage from '@/images/portfolio/comming_soon.webp';
import githubIcon from '@/images/icons/github.svg';
import ImageSlideAstro from '@/components/ImageSlide/astro/index.astro';

type Project = {
	classList?: string;
	url?: string;
	thumbnail?: ImageMetadata;
	thumbnailAlt?: string;
	title?: string;
	description?: string;
	tech?: string;
	tags?: string[];
	githubLink?: string;
	slideImages?: ImageMetadata[];
};

const { classList, url, thumbnail, thumbnailAlt, slideImages, title, description, tech, tags, githubLink } = Astro.props as Project;
const image = thumbnail ?? commingSoonImage;
const imageAlt = thumbnailAlt ?? 'Coming Soon';
const techItems = tech?.split(',').map((item) => item.trim()).filter(Boolean) ?? [];
---

<article class={`project-card ${classList ?? ''}`}>
	<div class="project-card__media">
		<ImageSlideAstro image={image} imageAlt={imageAlt} title={title} slideImages={slideImages} />
	</div>
	<div class="project-card__content">
		<p class="project-card__eyebrow">PUBLIC PROJECT</p>
		<h2>{title}</h2>
		{description && <p class="project-card__description">{description}</p>}

		{techItems.length > 0 && (
			<div class="project-card__tech" aria-label="使用技術">
				{techItems.map((item) => <span>{item}</span>)}
			</div>
		)}

		<div class="project-card__links">
			{url && (
				<a class="project-card__primary-link" href={url} target="_blank" rel="noopener noreferrer">
					公開ページを見る →
				</a>
			)}
			{githubLink && (
				<a class="project-card__github-link" href={githubLink} target="_blank" rel="noopener noreferrer">
					<Image src={githubIcon} alt="" width={20} height={20} />
					<span>GitHub</span>
				</a>
			)}
		</div>

		{tags && tags.length > 0 && (
			<div class="project-card__tags">
				{tags.map((tag) => <a href={`/posts/tags/${tag}/`}>#{tag}</a>)}
			</div>
		)}
	</div>
</article>

<style>
	.project-card {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: center;
		padding: clamp(1.2rem, 3vw, 2rem);
		border: 1px solid #e3e6ef;
		border-radius: 28px;
		background: rgba(255,255,255,.9);
		box-shadow: 0 16px 50px rgba(31,41,55,.06);
	}
	.project-card__media { min-width: 0; overflow: hidden; border-radius: 20px; }
	.project-card__content { min-width: 0; }
	.project-card__eyebrow {
		margin-bottom: .6rem;
		color: #4f46e5;
		font-size: .72rem;
		font-weight: 800;
		letter-spacing: .14em;
	}
	h2 {
		font-size: clamp(1.6rem, 3vw, 2.4rem);
		line-height: 1.1;
		letter-spacing: -.035em;
		font-weight: 800;
	}
	.project-card__description {
		margin-top: 1rem;
		color: #667085;
		line-height: 1.85;
	}
	.project-card__tech {
		display: flex;
		flex-wrap: wrap;
		gap: .45rem;
		margin-top: 1.3rem;
	}
	.project-card__tech span {
		padding: .35rem .65rem;
		border: 1px solid #e1e4ec;
		border-radius: 999px;
		color: #596176;
		background: #f8f9fc;
		font-size: .76rem;
	}
	.project-card__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: .75rem 1rem;
		margin-top: 1.5rem;
	}
	.project-card__primary-link {
		padding: .7rem 1rem;
		border-radius: 999px;
		color: white;
		background: #111827;
		font-weight: 700;
	}
	.project-card__github-link {
		display: inline-flex;
		align-items: center;
		gap: .4rem;
		color: #3e4658;
		font-weight: 700;
	}
	.project-card__tags { margin-top: 1rem; font-size: .8rem; }
	.project-card__tags a { margin-right: .6rem; color: #6366f1; }

	@media (max-width: 860px) {
		.project-card { grid-template-columns: 1fr; }
	}
</style>
