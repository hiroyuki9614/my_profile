---
import BaseLayout from './BaseLayout.astro';
const { title, description, type, image, canonical, structuredData } = Astro.props;
---

<BaseLayout title={title} description={description} type={type} image={image} canonical={canonical} structuredData={structuredData}>
	<main>
		<article class='wrapper'>
			<slot />
		</article>
	</main>
</BaseLayout>

<style>
	.wrapper {
		max-width: 80%;
		margin: 0 auto;
	}
</style>
