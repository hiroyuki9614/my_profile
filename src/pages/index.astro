---
import Layout from '@/layouts/Layout.astro';
import { pageInfo } from '@/data/pageInfo';
import { Image } from 'astro:assets';
import profileImage from '@/images/profile/bass.webp';

const metrics = [
	{ value: '約25万件', label: 'Laravel応募フォームの運用実績' },
	{ value: '2日', label: '再利用設計による類似案件の構築' },
	{ value: '半年+', label: 'CSV→XLSX自動化の継続運用' },
];

const strengths = [
	{
		title: 'Frontend modernization',
		text: 'Perlベースの応募フォーム基盤にReactを導入。既存資産を残しながら、変更頻度の高いフロント部分から段階的に置き換えました。',
	},
	{
		title: 'Change-friendly design',
		text: '計算ロジックとDOM操作の分離、Laravel機能の設定化・共通化など、仕様変更時に修正範囲を局所化する設計を重視しています。',
	},
	{
		title: 'Business automation',
		text: 'CSV・Excel・Access/VBAを使った業務自動化も経験。手作業を再現可能な処理へ置き換えることを得意としています。',
	},
];

const workHighlights = [
	{
		kicker: 'React / Astro',
		title: 'レガシー応募フォーム基盤のReactモダナイズ',
		description: '案件ごとに発生していたHTML・Perlの個別修正を減らすため、React導入を提案。構成検討から設計、実装、テスト、リリースまで担当しました。',
		result: '従来2〜3時間、複雑な場合は1日程度かかっていた定型調整の多くを不要化。',
	},
	{
		kicker: 'Next.js / TypeScript',
		title: 'クイズ付き応募アプリケーション',
		description: '状態管理を伴う応募アプリを2週間の納期で設計。TDDとドキュメント更新を前提に、類似案件へ展開しやすい構成にしました。',
		result: '既存設計を再利用した類似案件は約2日で構築。',
	},
	{
		kicker: 'JavaScript / Testing',
		title: '複数パターンの計算Webツール',
		description: '計算ロジック、DOM操作、表示文言、パターンデータを分離。Decimal.jsとMocha / Chaiを使い、数値計算の差異も検証しました。',
		result: '後続の計算式追加でも変更範囲を局所化。',
	},
	{
		kicker: 'Laravel / PHP',
		title: '応募フォームの共通基盤化',
		description: 'ローコードツールで対応できない案件をLaravelで複数開発。設定可能範囲と共通機能を案件ごとに拡張しました。',
		result: '本番運用中のフォーム項目変更をコード修正なしで完了。',
	},
];

const stack = ['TypeScript', 'JavaScript', 'React', 'Next.js', 'Astro', 'PHP', 'Laravel', 'WordPress', 'Playwright', 'VBA'];
---

<Layout title={pageInfo.profile.metaTitle} description={pageInfo.profile.metaDescription} type={pageInfo.profile.type}>
	<section class="hero">
		<div class="hero__content">
			<div>
				<p class="eyebrow">WEB ENGINEER / FRONTEND FOCUSED</p>
				<h1>変更しやすく、<br />次にも使える実装を。</h1>
				<p class="hero__lead">
					電気・制御設計を経てWeb開発へ。業務ロジックの整理、再利用、段階的なモダナイズを軸に、
					React / TypeScriptを使ったフロントエンド開発へ領域を広げています。
				</p>
				<div class="hero__actions">
					<a class="button button--primary" href="/portfolio/">公開プロジェクトを見る</a>
					<a class="button button--ghost" href="https://github.com/hiroyuki9614" target="_blank" rel="noopener noreferrer">GitHub</a>
				</div>
				<div class="stack" aria-label="主な技術スタック">
					{stack.map((item) => <span>{item}</span>)}
				</div>
			</div>
			<div class="hero__portrait">
				<Image src={profileImage} alt="Hiroyuki9614 profile" width={360} height={480} />
				<div class="hero__portrait-caption">
					<strong>Hiroyuki9614</strong>
					<span>Tokyo / Web Engineer</span>
				</div>
			</div>
		</div>
	</section>

	<section class="metrics" aria-label="実績サマリー">
		{metrics.map((metric) => (
			<div class="metric-card">
				<strong>{metric.value}</strong>
				<span>{metric.label}</span>
			</div>
		))}
	</section>

	<section class="section">
		<div class="section-heading">
			<p class="eyebrow">WHAT I DO</p>
			<h2>業務改善と変更容易性を、実装に落とし込む</h2>
			<p>「動けば終わり」ではなく、次の変更や次の案件で楽になる構造を考えて実装します。</p>
		</div>
		<div class="strength-grid">
			{strengths.map((strength) => (
				<article class="strength-card">
					<h3>{strength.title}</h3>
					<p>{strength.text}</p>
				</article>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section-heading section-heading--split">
			<div>
				<p class="eyebrow">SELECTED WORK</p>
				<h2>実務で取り組んだこと</h2>
			</div>
			<a class="text-link" href="/portfolio/">公開プロジェクト →</a>
		</div>
		<div class="work-list">
			{workHighlights.map((work, index) => (
				<article class="work-card">
					<div class="work-card__number">{String(index + 1).padStart(2, '0')}</div>
					<div>
						<p class="work-card__kicker">{work.kicker}</p>
						<h3>{work.title}</h3>
						<p>{work.description}</p>
						<p class="work-card__result"><span>Outcome</span>{work.result}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="section career-section">
		<div class="section-heading">
			<p class="eyebrow">CAREER</p>
			<h2>異なる現場で培った「再現性」</h2>
		</div>
		<div class="timeline">
			<div class="timeline__item">
				<span>01</span>
				<div>
					<h3>営業・事務</h3>
					<p>紙やFAXを中心とした業務を経験し、効率化・自動化に関心を持つきっかけになりました。</p>
				</div>
			</div>
			<div class="timeline__item">
				<span>02</span>
				<div>
					<h3>電気設計・制御</h3>
					<p>約5年間、設計・製図・制御盤・工事・検収まで一連の工程を経験。仕様を整理し、手順化して完成まで持っていく力を培いました。</p>
				</div>
			</div>
			<div class="timeline__item">
				<span>03</span>
				<div>
					<h3>Web開発</h3>
					<p>2024年からWeb実務へ。PHP / JavaScriptを起点に、React / Next.js / TypeScriptを使ったアプリケーション開発・モダナイズへ領域を拡大しています。</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section evidence-section">
		<div class="section-heading">
			<p class="eyebrow">EVIDENCE</p>
			<h2>コードと公開物</h2>
			<p>プロフィール上の説明だけでなく、公開できる成果物とコードへの導線も用意しています。</p>
		</div>
		<div class="evidence-grid">
			<a href="https://github.com/hiroyuki9614" target="_blank" rel="noopener noreferrer">
				<span>GitHub</span>
				<strong>公開リポジトリを見る →</strong>
			</a>
			<a href="https://boxing-ring.in/" target="_blank" rel="noopener noreferrer">
				<span>Personal project</span>
				<strong>BOXING RING.IN →</strong>
			</a>
			<a href="https://odt.hiroyuki9614.com/" target="_blank" rel="noopener noreferrer">
				<span>Personal project</span>
				<strong>ODO TRACK →</strong>
			</a>
			<a href="/posts/">
				<span>Writing</span>
				<strong>技術・開発記事を見る →</strong>
			</a>
		</div>
	</section>
</Layout>

<style>
	:global(body) {
		color: #172033;
		background:
			radial-gradient(circle at 15% 5%, rgba(79, 70, 229, 0.08), transparent 28rem),
			#f7f8fb;
	}

	.hero {
		padding: clamp(3rem, 8vw, 7rem) 0 3rem;
	}
	.hero__content {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(240px, .55fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
	}
	.eyebrow {
		margin-bottom: .85rem;
		color: #4f46e5;
		font-size: .75rem;
		font-weight: 800;
		letter-spacing: .18em;
	}
	.hero h1 {
		max-width: 820px;
		font-size: clamp(2.65rem, 7vw, 5.7rem);
		line-height: .98;
		letter-spacing: -.06em;
		font-weight: 800;
	}
	.hero__lead {
		max-width: 760px;
		margin-top: 1.6rem;
		color: #596176;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.9;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: .75rem;
		margin-top: 2rem;
	}
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: .75rem 1.25rem;
		border-radius: 999px;
		font-weight: 700;
		transition: transform .18s ease, box-shadow .18s ease;
	}
	.button:hover { transform: translateY(-2px); }
	.button--primary {
		color: white;
		background: #111827;
		box-shadow: 0 12px 30px rgba(17, 24, 39, .14);
	}
	.button--ghost {
		color: #283044;
		border: 1px solid #d9ddea;
		background: rgba(255, 255, 255, .72);
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: .45rem;
		margin-top: 2rem;
	}
	.stack span {
		padding: .35rem .65rem;
		border: 1px solid #e0e3ec;
		border-radius: 999px;
		color: #596176;
		background: rgba(255,255,255,.75);
		font-size: .78rem;
	}
	.hero__portrait {
		justify-self: end;
		width: min(100%, 320px);
		padding: .75rem;
		border: 1px solid rgba(255,255,255,.8);
		border-radius: 28px;
		background: rgba(255,255,255,.7);
		box-shadow: 0 24px 70px rgba(31,41,55,.12);
		transform: rotate(1.5deg);
	}
	.hero__portrait :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 20px;
	}
	.hero__portrait-caption {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: .9rem .35rem .15rem;
		color: #667085;
		font-size: .8rem;
	}
	.hero__portrait-caption strong { color: #202939; }

	.metrics {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin: 1rem 0 6rem;
	}
	.metric-card {
		padding: 1.4rem;
		border: 1px solid #e4e7ef;
		border-radius: 20px;
		background: rgba(255,255,255,.85);
	}
	.metric-card strong {
		display: block;
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		letter-spacing: -.04em;
	}
	.metric-card span {
		color: #6a7285;
		font-size: .9rem;
	}

	.section { margin: 7rem 0; }
	.section-heading { max-width: 760px; margin-bottom: 2rem; }
	.section-heading h2 {
		font-size: clamp(2rem, 4vw, 3.5rem);
		line-height: 1.08;
		letter-spacing: -.045em;
		font-weight: 800;
	}
	.section-heading > p:last-child {
		margin-top: 1rem;
		color: #687186;
		line-height: 1.8;
	}
	.section-heading--split {
		max-width: none;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}
	.text-link { color: #4f46e5; font-weight: 700; white-space: nowrap; }

	.strength-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}
	.strength-card {
		min-height: 230px;
		padding: 1.65rem;
		border: 1px solid #e3e6ef;
		border-radius: 24px;
		background: white;
	}
	.strength-card h3 { margin-bottom: 1rem; font-size: 1.15rem; }
	.strength-card p { color: #687186; line-height: 1.8; }

	.work-list { border-top: 1px solid #dfe3ec; }
	.work-card {
		display: grid;
		grid-template-columns: 72px minmax(0,1fr);
		gap: 1.5rem;
		padding: 2rem 0;
		border-bottom: 1px solid #dfe3ec;
	}
	.work-card__number { color: #98a2b3; font-size: .85rem; font-weight: 700; }
	.work-card__kicker { color: #4f46e5; font-size: .78rem; font-weight: 800; letter-spacing: .08em; }
	.work-card h3 { margin: .35rem 0 .7rem; font-size: clamp(1.35rem, 2.5vw, 2rem); letter-spacing: -.025em; }
	.work-card p { max-width: 850px; color: #626b7f; line-height: 1.8; }
	.work-card__result {
		margin-top: 1rem;
		padding-left: 1rem;
		border-left: 3px solid #4f46e5;
		color: #333d52 !important;
	}
	.work-card__result span {
		margin-right: .7rem;
		color: #4f46e5;
		font-size: .75rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.career-section {
		padding: clamp(2rem, 5vw, 4rem);
		border-radius: 32px;
		color: #f8fafc;
		background: #111827;
	}
	.career-section .eyebrow { color: #a5b4fc; }
	.timeline { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
	.timeline__item { padding-top: 1.2rem; border-top: 1px solid #374151; }
	.timeline__item > span { color: #818cf8; font-size: .8rem; font-weight: 800; }
	.timeline__item h3 { margin: .65rem 0 .7rem; font-size: 1.15rem; }
	.timeline__item p { color: #cbd5e1; line-height: 1.75; }

	.evidence-grid {
		display: grid;
		grid-template-columns: repeat(2,1fr);
		gap: 1rem;
	}
	.evidence-grid a {
		display: flex;
		flex-direction: column;
		gap: .35rem;
		padding: 1.5rem;
		border: 1px solid #e2e5ed;
		border-radius: 18px;
		background: white;
		transition: transform .18s ease, border-color .18s ease;
	}
	.evidence-grid a:hover { transform: translateY(-2px); border-color: #a5b4fc; }
	.evidence-grid span { color: #7c8497; font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; }
	.evidence-grid strong { color: #222b3d; }

	@media (max-width: 820px) {
		.hero__content { grid-template-columns: 1fr; }
		.hero__portrait { justify-self: start; max-width: 260px; }
		.metrics, .strength-grid, .timeline { grid-template-columns: 1fr; }
		.section-heading--split { align-items: flex-start; flex-direction: column; }
		.evidence-grid { grid-template-columns: 1fr; }
		.work-card { grid-template-columns: 42px minmax(0,1fr); gap: .75rem; }
	}
</style>
