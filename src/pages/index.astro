---
import Layout from '@/layouts/Layout.astro';
import PageTitle from '@/components/PageTitle/index.astro';
import { pageInfo } from '@/data/pageInfo';
import { Image } from 'astro:assets';
import profileImage from '@/images/profile/bass.webp';

const metrics = [
	{ value: '約25万件', label: 'Laravel応募フォームの運用実績' },
	{ value: '2日', label: '再利用設計による類似案件の構築' },
	{ value: '半年+', label: 'CSV→XLSX自動化の継続運用' },
];

const strengths = [
	{
		title: 'フロントエンドの改善',
		text: 'Perlベースの応募フォーム基盤にReactを導入。既存資産を残しながら、変更頻度の高いフロント部分から段階的に置き換えました。',
	},
	{
		title: '変更しやすい設計',
		text: '計算ロジックとDOM操作の分離、Laravel機能の設定化・共通化など、仕様変更時に修正範囲を局所化する設計を重視しています。',
	},
	{
		title: '業務の自動化',
		text: 'CSV・Excel・Access/VBAを使った業務自動化も経験。手作業を再現可能な処理へ置き換えることを得意としています。',
	},
];

const workHighlights = [
	{
		kicker: 'React / Astro',
		title: 'レガシー応募フォーム基盤のReactモダナイズ',
		description: '案件ごとに発生していたHTML・Perlの個別修正を減らすため、React導入を提案。構成検討から設計、実装、テスト、リリースまで担当しました。',
		result: '従来2〜3時間、複雑な場合は1日程度かかっていた定型調整の多くを不要化。',
	},
	{
		kicker: 'Next.js / TypeScript',
		title: 'クイズ付き応募アプリケーション',
		description: '状態管理を伴う応募アプリを2週間の納期で設計。TDDとドキュメント更新を前提に、類似案件へ展開しやすい構成にしました。',
		result: '既存設計を再利用した類似案件は約2日で構築。',
	},
	{
		kicker: 'JavaScript / Testing',
		title: '複数パターンの計算Webツール',
		description: '計算ロジック、DOM操作、表示文言、パターンデータを分離。Decimal.jsとMocha / Chaiを使い、数値計算の差異も検証しました。',
		result: '後続の計算式追加でも変更範囲を局所化。',
	},
	{
		kicker: 'Laravel / PHP',
		title: '応募フォームの共通基盤化',
		description: 'ローコードツールで対応できない案件をLaravelで複数開発。設定可能範囲と共通機能を案件ごとに拡張しました。',
		result: '本番運用中のフォーム項目変更をコード修正なしで完了。',
	},
];

const stack = ['TypeScript', 'JavaScript', 'React', 'Next.js', 'Astro', 'PHP', 'Laravel', 'WordPress', 'Playwright', 'VBA'];

const dtClass = 'text-lg font-bold mb-2';
const profileContainerClass = 'text-base text-gray-700';
const articleTitleClass = 'text-2xl font-bold';
---

<Layout title={pageInfo.profile.metaTitle} description={pageInfo.profile.metaDescription} type={pageInfo.profile.type}>
	<section>
		<PageTitle title={pageInfo.profile.headingTitle} />
		<div class='container flex flex-col items-center gap-8'>
			<Image src={profileImage} alt='プロフィール画像' width={300} height={400} class='rounded-xl' />
			<div class='text-center'>
				<p class='text-lg font-bold'>Hiroyuki9614</p>
				<p class='text-sm text-gray-600'>リファクタリングが好きです</p>
			</div>
			<article class='max-w-2xl text-left'>
				<div class={`${profileContainerClass} mb-4`}>
					<h2 class={`${articleTitleClass} mb-4`}>業務改善を軸にしたWebプログラマーです</h2>
					<p class='mb-4'>電気・制御設計を経て、2024年からWeb開発の実務に携わっています。業務ロジックの整理、再利用、段階的なモダナイズを軸に、React / TypeScriptを使ったフロントエンド開発へ領域を広げています。</p>
					<dl>
						<dt class={dtClass}>よく使う言語</dt>
						<dd>JavaScript / TypeScript, PHP</dd>
						<dd class='mb-4'>業務ではWordPressやLaravelも使用しています。</dd>
						<dt class={dtClass}>現在の業務</dt>
						<dd class='mb-4'>WEB制作, システム開発, 社内向けのツール制作など</dd>
						<dt class={dtClass}>こだわっていること</dt>
						<dd class='mb-4'>仕事の再現性を上げるため、身体も日々鍛錬しています！</dd>
					</dl>
				</div>
				<div class={`${profileContainerClass} mb-4`}>
					<h2 class={`${articleTitleClass} mb-4`}>今の業務での経験</h2>
					{workHighlights.map((work) => (
						<div class='mb-4'>
							<h3 class={dtClass}>{work.title}</h3>
							<p class='mb-1'>{work.kicker}</p>
							<p>{work.description}</p>
							<p>{work.result}</p>
						</div>
					))}
					<dl class='mb-4'>
						{metrics.map((metric) => (
							<div class='mb-2'>
								<dt class='font-bold'>{metric.label}</dt>
								<dd>{metric.value}</dd>
							</div>
						))}
					</dl>
				</div>
				<div class={`${profileContainerClass} mb-4`}>
					<h2 class={`${articleTitleClass} mb-4`}>スキル</h2>
					<h3 class={dtClass}>経験言語/フレームワーク</h3>
					<p class='mb-4'>{stack.join(' / ')}</p>
					{strengths.map((strength) => (
						<div class='mb-4'>
							<h3 class={dtClass}>{strength.title}</h3>
							<p>{strength.text}</p>
						</div>
					))}
				</div>
				<div class={`${profileContainerClass} mb-4`}>
					<h2 class={`${articleTitleClass} mb-4`}>プログラマーになる前の経歴</h2>
					<div class='mb-4'>
						<div class={dtClass}>営業/事務職</div>
						<div>キャリアのスタートはメーカーの営業職と事務職でした。</div>
						<div>古い体制の業界で、紙やFAXを中心とした業務が多く、効率化や自動化の重要性を強く感じました。</div>
						<div>この時に、効率化や自動化の重要性を強く感じたことが間違いなく今の原点になっています。</div>
					</div>
					<div class='mb-4'>
						<div class={dtClass}>電気設計/制御</div>
						<div>およそ5年間、プラント設備を中心とした強電分野および電気制御分野において、</div>
						<div>電気設計を担当していました。</div>
						<div>制御盤設計、配線図作成、施工管理補助に加え、設計から製図、制御盤組立、工事、検収まで一貫して対応した経験があります。</div>
						<div>また、プログラミング経験がない状態からでも、現場での調整や</div>
						<div>試行錯誤を通じて検収まで対応した経験があります。</div>
					</div>
				</div>
				<div class={`${profileContainerClass} mb-4`}>
					<h2 class={`${articleTitleClass} mb-4`}>コードと公開物</h2>
					<ul class='list-disc pl-5'>
						<li><a class='underline' href='/portfolio/'>公開プロジェクト</a></li>
						<li><a class='underline' href='https://github.com/hiroyuki9614' target='_blank' rel='noopener noreferrer'>GitHub</a></li>
						<li><a class='underline' href='https://boxing-ring.in/' target='_blank' rel='noopener noreferrer'>BOXING RING.IN</a></li>
						<li><a class='underline' href='https://odt.hiroyuki9614.com/' target='_blank' rel='noopener noreferrer'>ODO TRACK</a></li>
						<li><a class='underline' href='/posts/'>技術・開発記事</a></li>
					</ul>
				</div>
			</article>
		</div>
	</section>
</Layout>
